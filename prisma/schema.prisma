// Veloce — Prisma Schema
// Multi-university academic notes marketplace

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer, via Neon's "-pooler" host) — every
  // serverless function invocation on Vercel opens its own connection, and
  // without pooling this app can exhaust Postgres's connection limit under
  // real traffic. DIRECT_URL bypasses the pooler for schema migrations,
  // which need a direct, transaction-capable connection — set both in
  // Vercel's env vars (DATABASE_URL to the "-pooler" host, DIRECT_URL to
  // the plain host; Neon's dashboard shows both connection strings).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Institutional hierarchy
// ─────────────────────────────────────────────

model University {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique // e.g. "babcock", "unilag" — used for routing
  departments          Department[]
  users                User[]
  pendingRegistrations PendingRegistration[]
  createdAt            DateTime              @default(now())
}

model Department {
  id           String     @id @default(uuid())
  name         String
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  courses      Course[]
  users        User[] // students whose academic profile (see onboarding) points here

  @@unique([universityId, name])
}

model Course {
  id           String     @id @default(uuid())
  name         String
  code         String // e.g. "COS 201"
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  blocks       Block[]
  requests     BlockRequest[]

  @@unique([departmentId, code])
}

model Block {
  id        String         @id @default(uuid())
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String // e.g. "Block 1: Foundations" — freely named by the scribe who creates it
  order     Int // sequence within the course (1, 2, 3...)
  level     String? // actual academic level of the scribe who wrote it (e.g. "100L")
  price     Int            @default(1000) // Naira, kobo-free flat price
  topics    Topic[] // at least 3 required at creation — what this block actually covers
  notes     Note[]
  requests  BlockRequest[]
  purchases Purchase[]
  reports   Report[]
  createdAt DateTime       @default(now())

  @@unique([courseId, order])
}

// A short outline item describing what a block covers — shown to students
// browsing before they buy. Every block needs at least 3 of these.
model Topic {
  id      String @id @default(uuid())
  blockId String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  title   String
  order   Int

  @@unique([blockId, order])
}

// ─────────────────────────────────────────────
// Users & roles
// ─────────────────────────────────────────────

enum UserRole {
  STUDENT
  SCRIBE
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String

  // Login rate-limiting — a failed attempt increments this; enough failures
  // in a row locks the account for a cooldown window regardless of whether
  // a later attempt has the right password. Resets to 0 on any successful
  // login or password reset.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Self-service password reset — same token/expiry pattern as email
  // verification below, deliberately separate fields so a pending
  // verification and a pending reset can never collide with each other.
  passwordResetToken            String?   @unique
  passwordResetExpiresAt        DateTime?
  lastPasswordResetEmailSentAt  DateTime? // rate-limits the forgot-password form

  // Set once the signup verification link is clicked. Login is blocked
  // entirely until this is non-null — see app/api/auth/login/route.ts.
  emailVerifiedAt             DateTime?
  emailVerificationToken      String?   @unique
  emailVerificationExpiresAt  DateTime?
  lastVerificationEmailSentAt DateTime? // rate-limits the resend button
  fullName     String

  // Display preference — synced to whatever device/browser the person
  // signs into, not just localStorage on one machine. See lib/theme.ts.
  theme        String   @default("light")

  // Profile icon: an uploaded image (Vercel Blob URL, same as note files —
  // see lib/storage.ts saveAvatarImage), re-uploadable anytime. avatarDisplay
  // is the person's own choice of whether it's actually shown — uploading
  // doesn't force it on, and switching back to the generic icon doesn't
  // delete the upload, so toggling back and forth needs no re-upload.
  avatarUrl     String?
  avatarDisplay String  @default("default") // "default" | "custom"

  // Refund credit: a running ₦ balance, not a count of "free purchase"
  // tokens. Granted per-refund equal to exactly what the buyer lost (see
  // app/api/admin/purchases/[id]/refund/route.ts), and applied as a
  // partial-payment credit on the buyer's next purchase(s) — never more
  // than that purchase's real price, with any leftover carried forward.
  // See app/api/payments/initialize/route.ts.
  // Real, unencumbered cash — always spendable 1:1, never expires, no
  // limit. Granted in full on an approved refund or a converted duplicate
  // payment; never partially "backed" (see the escrow model in
  // lib/pricing.ts, which is what makes that always safe).
  creditBalance Int     @default(0)
  role         UserRole @default(STUDENT)

  // Case-insensitive uniqueness for fullName (kept as a plain lowercased
  // copy since Prisma can't express a functional unique index directly).
  // Set once at signup and never changed — see app/api/auth/signup.
  fullNameNormalized String @unique

  // When this account agreed to the Terms of Service — collected as a
  // required, un-checked-by-default checkbox at signup (see
  // PendingRegistration.termsAcceptedAt, which is where it's actually
  // captured; this column is just where it lands once the account is
  // real). Nullable only because accounts created before this existed
  // don't have it — every new signup always sets it.
  termsAcceptedAt DateTime?

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departmentId String? // student's own department, optional
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  level        String? // e.g. "200L"
  lastLoginAt  DateTime?
  lastSeenAt   DateTime?

  // Scribe-facing public reputation (only meaningful when role = SCRIBE)
  ratingAvg    Float? // rolling average, denormalized for fast profile reads
  ratingCount  Int        @default(0)

  // Set whenever an admin demotes this user from SCRIBE back to STUDENT;
  // cleared again if a later appeal or re-application is approved. Powers
  // both "is this person eligible to appeal at all" and the once-a-month
  // appeal cooldown (alongside ScribeApplication.reviewedAt).
  demotedAt DateTime?

  // Bank details for withdrawals — only meaningful when role = SCRIBE.
  // accountName is what Paystack's own account-resolve API returned, not
  // freely typed, so it should always match the real name on the account.
  // payoutRecipientCode is Paystack's transfer-recipient id, created once
  // and cached here so we never re-register the same account twice.
  bankCode             String?
  bankName             String?
  accountNumber        String?
  accountName          String?
  payoutRecipientCode  String?

  // Ban/suspension — banExpiresAt null means indefinite ("until further
  // notice"); a real date means a timed suspension (e.g. 3 months). A
  // scribe's notes, sales, and earnings are never touched by a ban — only
  // login (and every subsequent authenticated action) is blocked while it's
  // active. See lib/ban.ts for the expiry/email logic.
  bannedAt     DateTime?
  banReason    String?
  banExpiresAt DateTime?
  bannedById   String?

  scribeApplications ScribeApplication[]
  notes              Note[]               @relation("ScribeNotes")
  purchases          Purchase[]
  requestVotes       RequestVote[]
  reviews            Review[]
  payouts            Payout[]
  following          Follow[]             @relation("Following") // scribes this user follows
  followers          Follow[]             @relation("Followers") // followers of this user (meaningful when role = SCRIBE)
  reportsFiled       Report[]             @relation("ReportsFiled")
  reportsReceived    Report[]             @relation("ReportsReceived")

  createdAt          DateTime             @default(now())
  receivedMessages   AdminMessage[]       @relation("MessageRecipient")
  sentMessages       AdminMessage[]       @relation("MessageSender")
  feedback           Feedback[]
  adminSectionViews  AdminSectionView[]   @relation("AdminSectionViews")
  convertedPayments  ConvertedPayment[]
  pollVotes          PollVote[]
}

// One-way messages from an Admin to a specific user — e.g. explaining a
// rejected application or a demotion. No reply thread by design.
// senderId is nullable so automated system messages (new-account welcome)
// can be created with no admin actor behind them; the UI shows those as
// coming from "Veloce" when sender is null.
enum MessageType {
  TEXT
  POLL
}

enum MessagePriority {
  NORMAL
  // Blocks the recipient from using the app (see app/components/BlockingMessageModal.tsx
  // and GET /api/messages/blocking) until they open and acknowledge it.
  SERIOUS
}

model AdminMessage {
  id          String          @id @default(uuid())
  recipientId String
  recipient   User            @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?           @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  subject     String
  body        String
  type        MessageType     @default(TEXT)
  priority    MessagePriority @default(NORMAL)
  readAt      DateTime?
  createdAt   DateTime        @default(now())

  // Only populated when type = POLL. A poll sent to several recipients is
  // one AdminMessage row PER recipient, each with its own copy of the
  // options — votes are per-message (see PollVote's unique constraint), so
  // a shared options list across recipients would let one person's vote
  // count show up on everyone else's poll.
  pollOptions PollOption[]
}

model PollOption {
  id        String       @id @default(uuid())
  messageId String
  message   AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  label     String
  order     Int
  votes     PollVote[]

  @@unique([messageId, order])
}

model PollVote {
  id        String     @id @default(uuid())
  messageId String // denormalized from optionId for the one-vote-per-message constraint below
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  // The whole point: one vote per person per poll, enforced by the
  // database, not just checked in application code.
  @@unique([messageId, userId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// APPLICATION = student applying to become a scribe for the first time.
// APPEAL = a demoted former scribe asking to be reinstated. Same shape,
// same review workflow, kept in one model/table and distinguished by type.
// userId is intentionally NOT unique — a person can have many rows over
// time (rejected application -> reapplied later; demoted -> appealed
// months apart, etc). Cooldowns are enforced in the API layer by looking
// at the most recent row of the relevant type.
enum ApplicationType {
  APPLICATION
  APPEAL
}

model ScribeApplication {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ApplicationType   @default(APPLICATION)
  reason       String
  status       ApplicationStatus @default(PENDING)
  submittedAt  DateTime          @default(now())
  reviewedAt   DateTime?
  reviewedById String? // admin user id

  @@index([userId, type, submittedAt])
}

// ─────────────────────────────────────────────
// Notes (competing uploads per block)
// ─────────────────────────────────────────────

enum NoteStatus {
  PENDING_REVIEW // awaiting automated check
  FLAGGED // automated check flagged it, needs manual review
  APPROVED // passed checks / manual review
  LIVE // visible and purchasable
  REJECTED
}

model Note {
  id       String  @id @default(uuid())
  blockId  String
  block    Block   @relation(fields: [blockId], references: [id], onDelete: Cascade)
  scribeId String
  scribe   User    @relation("ScribeNotes", fields: [scribeId], references: [id], onDelete: Cascade)

  fileUrl String // stored filename on disk — NOT a public URL; access is gated
  extractedText String? // raw text pulled from the PDF, used by the quality gate
  status  NoteStatus @default(PENDING_REVIEW)
  pageCount Int? // total pages — set once, the first time any page gets rendered

  // Automated quality gate results
  similarityScore  Float? // vs other notes in same block — high score = likely duplicate
  qualityScore     Float? // AI completeness/quality pass, 0-1
  flaggedForReview Boolean @default(false)
  // Human-readable reasons the automated gate (or an upload-time policy
  // rule, e.g. "first upload from this scribe") flagged this note —
  // semicolon-joined, shown as-is in the moderation queue. Null when
  // flaggedForReview is false. See lib/quality-check.ts.
  flagReason String?

  // The scribe's own affirmative confirmation, checked at upload time,
  // that this is their original work from attending the lecture — not
  // sourced from slides, a textbook, or someone else's notes. Doesn't
  // prove anything by itself, but it's what turns "we found out later"
  // into a clear-cut policy violation with a paper trail, not just a
  // he-said-she-said dispute. See app/scribe/upload/page.tsx.
  attestedOriginal Boolean @default(false)

  // If this note was uploaded to fulfill a demand-feed request
  fulfillsRequestId String?
  fulfillsRequest   BlockRequest? @relation(fields: [fulfillsRequestId], references: [id], onDelete: SetNull)

  purchases  Purchase[]
  reviews    Review[]
  pageImages NotePageImage[] // cached, un-watermarked page renders — see lib/pdf-render.ts
  reports    Report[]

  createdAt DateTime @default(now())

  @@index([status])
  @@index([scribeId])
  @@index([status, scribeId])
}

// A cached, plain (no watermark) render of one page of a note's PDF.
// Rendering a PDF page to an image is the expensive part, so it happens
// once per page ever and gets reused for every future viewer; the
// watermark itself is stamped fresh on top of this at request time (see
// /api/notes/[id]/page/[num]) since it must always match whoever's
// actually looking, and must never be cached with the wrong name on it.
model NotePageImage {
  id        String   @id @default(uuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pageNum   Int
  imageUrl  String
  createdAt DateTime @default(now())

  @@unique([noteId, pageNum])
}

// ─────────────────────────────────────────────
// Demand feed (requests)
// ─────────────────────────────────────────────

enum RequestStatus {
  OPEN
  FULFILLED
}

// A request describes content a student WANTS that doesn't exist yet.
// It only gets a real Block once a scribe fulfills it — courseId is what's
// required up front; blockId is filled in at fulfillment time.
model BlockRequest {
  id             String        @id @default(uuid())
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requestedTitle String // what the student wants covered, in their own words
  status         RequestStatus @default(OPEN)
  blockId        String? // set once a scribe's upload fulfills this
  block          Block?        @relation(fields: [blockId], references: [id], onDelete: SetNull)
  votes          RequestVote[] // one per student who requested this — the demand count
  claims         Note[] // competing scribe uploads claiming this request
  createdAt      DateTime      @default(now())
}

// One row per student who requested a given block — powers the demand counter
// and lets us know who gets the fulfilled-request discount.
model RequestVote {
  id        String       @id @default(uuid())
  requestId String
  request   BlockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  studentId String
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([requestId, studentId])
}

// ─────────────────────────────────────────────
// Purchases, reviews, payouts
// ─────────────────────────────────────────────

model Purchase {
  id              String   @id @default(uuid())
  buyerId         String
  buyer           User     @relation(fields: [buyerId], references: [id])
  noteId          String
  note            Note     @relation(fields: [noteId], references: [id])
  blockId         String
  block           Block    @relation(fields: [blockId], references: [id])
  amountPaid      Int // actual amount charged, after any discount — 0 if redeemedWithCoupon
  discountApplied Boolean  @default(false)
  paystackRef     String   @unique
  purchasedAt     DateTime @default(now())
  review          Review?
  reports         Report[]

  // Refunds: access is revoked and this purchase drops out of every
  // earnings/revenue calculation entirely once refunded — see
  // lib/pricing.ts and lib/note-access.ts.
  refundedAt      DateTime?

  // Credit redemptions: creditApplied is how much of the buyer's credit
  // balance (see User.creditBalance) went toward this purchase — can be
  // partial (amountPaid > 0) or the full price (amountPaid is 0).
  // redeemedWithCoupon is true whenever creditApplied > 0. The scribe's cut
  // is always computed from amountPaid + creditApplied together (see
  // effectivePrice in lib/pricing.ts), never from amountPaid alone, since
  // that would shortchange the scribe whenever credit covered part of the
  // price.
  // Set alongside refundedAt specifically when a Paystack chargeback/dispute
  // triggers the reversal (see app/api/webhooks/paystack/route.ts), so the
  // admin finance page can tell "I approved this refund" apart from "the
  // buyer's bank clawed this back without asking us." No credit is granted
  // for a dispute — see the webhook handler for why.
  disputedAt         DateTime?
  redeemedWithCoupon Boolean @default(false)
  creditApplied      Int     @default(0)

  // Set the first time the BUYER (never an admin or the scribe just
  // previewing their own note) actually opens a page of this purchase —
  // see app/api/notes/[id]/page/[num]/route.ts. Never updated again after
  // that first write, so it answers one question only: "did they ever
  // start reading this?" Powers the "you haven't opened this yet" nudge
  // on the purchases page — nothing else reads it.
  firstOpenedAt DateTime?

  @@index([buyerId])
  @@index([noteId])
  @@index([refundedAt])
  @@index([buyerId, noteId])
}

// A Paystack charge that could NOT become a purchase and was turned into
// spendable credit instead — either the buyer already owned the note
// (duplicate payment) or the credit the checkout had reserved was spent
// elsewhere before it finished. It was never a sale, so the whole amount
// becomes credit; nothing is split. The unique paystackRef is the
// idempotency guard: the browser's verify call and Paystack's webhook both
// report the same charge, and only the first one may ever grant the credit.
model ConvertedPayment {
  id          String   @id @default(uuid())
  paystackRef String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int // cash actually charged — becomes credit in full, dollar for dollar (see lib/pricing.ts)
  reason      String // "DUPLICATE" | "CREDIT_CHANGED"
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Review {
  id         String   @id @default(uuid())
  purchaseId String   @unique
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  noteId     String
  note       Note     @relation(fields: [noteId], references: [id])
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────
// Scribe reputation — follows
// ─────────────────────────────────────────────

// A student following a scribe without necessarily having bought from them —
// distinct from paid-subscriber count, which comes from Purchase instead.
model Follow {
  id         String   @id @default(uuid())
  followerId String
  follower   User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  scribeId   String
  scribe     User     @relation("Followers", fields: [scribeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, scribeId])
}

enum PayoutStatus {
  PENDING // scribe requested, awaiting admin approval
  PROCESSING // admin approved, Paystack transfer initiated, not yet confirmed
  PAID
  FAILED
}

// A scribe-initiated withdrawal request. One request per calendar month,
// only submittable in the first 7 days of the month (enforced in the API,
// not here) — the admin's approval is what actually triggers the Paystack
// transfer (see lib/paystack.ts initiateTransfer), so this row's status
// tracks that whole lifecycle: request -> approval -> Paystack's own
// eventual confirmation via webhook.
model Payout {
  id                  String       @id @default(uuid())
  scribeId            String
  scribe              User         @relation(fields: [scribeId], references: [id], onDelete: Cascade)
  amount              Int // Naira — whatever the scribe chose to withdraw, up to their balance
  status              PayoutStatus @default(PENDING)
  requestedAt         DateTime     @default(now())
  processedAt         DateTime? // when an admin approved it and the transfer was initiated
  processedById       String? // admin user id
  paidAt              DateTime? // when Paystack's webhook confirmed it actually completed
  paystackTransferRef String?      @unique // our own reference, passed to Paystack's transfer API
  failureReason       String?
  createdAt           DateTime     @default(now())

  @@index([scribeId, requestedAt])
}

enum ReportType {
  BLOCK // flagging a block's content (wrong/stolen/low-quality notes, etc.)
  USER // flagging a specific person for malicious behavior
  REFUND // buyer wants their money back on a specific purchase
}

enum ReportStatus {
  PENDING
  DISMISSED // admin looked, no action needed
  ACTIONED // admin took action (removed content, demoted/warned the user, etc.)
}

// One record covers both "report this block" and "report this user" — kept
// in one table since the admin review workflow (list pending, dismiss vs
// act) is identical either way; `type` plus whichever of blockId /
// reportedUserId is set tells you which kind it is.
model Report {
  id             String       @id @default(uuid())
  type           ReportType
  reporterId     String
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  blockId        String?
  block          Block?       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?        @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  // Set when a report is filed against one specific scribe's version
  // rather than the block generically — lets an admin jump straight to the
  // exact upload in question instead of guessing among however many
  // versions that block has.
  noteId         String?
  note           Note?        @relation(fields: [noteId], references: [id], onDelete: Cascade)
  // Set for REFUND-type reports — lets the admin see exactly what was
  // bought and when, alongside when it was reported.
  purchaseId     String?
  purchase       Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  reviewedAt     DateTime?
  reviewedById   String? // admin user id

  @@index([type, status])
}

// Free-text "what do you think of the site" feedback from any logged-in
// user. Deliberately just a message + who + when — no categories, ratings,
// or status workflow. Read by admins at /admin/feedback.
model Feedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}

// Deliberately simple, DB-backed rate limiting — see lib/rate-limit.ts for
// why this beats an in-memory counter on a serverless host like Vercel.
// One row per (bucket + identifier) key, e.g. "login:102.67.15.8".
model RateLimitHit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
}

// ─────────────────────────────────────────────
// Admin section view tracking
// ─────────────────────────────────────────────

// Tracks when each admin last opened a "view-only" admin section whose
// badge should clear on visit (feedback, financial ledger). Action
// sections (reports, applications, etc.) don't use this — their badges
// are pure pending counts and stay until the item is resolved.
model AdminSectionView {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation("AdminSectionViews", fields: [adminId], references: [id], onDelete: Cascade)
  section    String // "feedback" | "ledger"
  lastSeenAt DateTime @default(now())

  @@unique([adminId, section])
}

// ─────────────────────────────────────────────
// Staged sign-up
// ─────────────────────────────────────────────

// Sign-up no longer writes to User directly — the submitted form sits here
// until the email link is clicked, and only THEN does a real User row get
// created (see app/api/auth/signup and app/api/auth/verify-email). This
// keeps unverified, possibly-fake signups out of the real user table
// entirely, and makes the "must verify within 5 minutes" rule a hard
// property of storage rather than just a UI countdown a person could
// ignore by never clicking away.
model PendingRegistration {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  fullName     String
  // Same case-insensitive uniqueness as User.fullNameNormalized, checked
  // against BOTH tables at signup so two people can't simultaneously claim
  // the same name in the few minutes before either verifies.
  fullNameNormalized String @unique

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departmentId String?
  level        String?

  // Required at signup (see the zod schema in app/api/auth/signup) — this
  // is never null in practice, only nullable because Prisma has no
  // "NOT NULL, set exactly once" shorthand.
  termsAcceptedAt DateTime?

  verificationToken String   @unique
  createdAt         DateTime @default(now())
  // Strict 5-minute deadline from createdAt — resending a link (see
  // app/api/auth/resend-verification) issues a fresh token but does NOT
  // push this deadline out further. Past it, verify-email deletes the row
  // outright and the person has to sign up again from scratch.
  expiresAt         DateTime

  @@index([expiresAt])
